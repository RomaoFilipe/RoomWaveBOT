# ============================================
# ROOMWAVE
# ============================================

NODE_ENV=development

# API
API_PORT=3001
API_HOST=0.0.0.0

# Dashboard
DASHBOARD_PORT=3000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=roomwave
POSTGRES_USER=roomwave
POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql://roomwave:CHANGE_ME@postgres:5432/roomwave

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# AzuraCast
AZURACAST_URL=
AZURACAST_API_KEY=
AZURACAST_STATION_ID=

# IMVU
IMVU_ENABLED=false

# Security
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
YOUTUBE_API_KEY=

# YouTube Music search and just-in-time YouTube audio resolution
YTMUSIC_PYTHON=/home/ubuntu/roomwave/tools/ytmusic-test/.venv/bin/python
YTMUSIC_RESOLVER=/home/ubuntu/roomwave/tools/ytmusic-test/resolver.py
YTDLP_BIN=/home/ubuntu/roomwave/tools/audio-gateway/.venv/bin/yt-dlp
FFMPEG_BIN=ffmpeg
ROOMWAVE_AUDIO_ENGINE_URL=http://127.0.0.1:3210

# RoomWave Bot
ROOMWAVE_API_URL=http://127.0.0.1:3001
ROOMWAVE_ROOM_ID=
ROOMWAVE_BOT_USER_ID=

# Public radio link shown by !radio
ROOMWAVE_PUBLIC_RADIO_URL=https://13-220-164-169.sslip.io/roomwave.mp3
